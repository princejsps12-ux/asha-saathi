# ASHA Saathi — optional configuration.
# The app runs fully WITHOUT any of these keys (offline mode:
# browser Web Speech API + built-in rule-based parser).
# Copy to .env and fill in only what you want to upgrade.

# Optional: server-side speech-to-text via Sarvam AI (Indian languages).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# Optional: LLM-assisted field extraction via Google Gemini.
# The rule-based parser always runs and stays the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Timezone used for "kal" / "agle hafte" date maths.
APP_TZ=Asia/Kolkata

# Host port for the web app.
PORT=8000
